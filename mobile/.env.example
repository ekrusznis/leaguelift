EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_FRONTEND_BASE_URL=http://localhost:5173
EXPO_PUBLIC_ENVIRONMENT_NAME=development
# Phase 37 (ADR-111) — must match the backend's GOOGLE_OAUTH_CLIENT_ID. Blank is fine;
# the login screen's "Continue with Google" button shows a "coming soon" toast instead
# of starting the sign-in flow until this is set. No Apple equivalent needed here — the
# Apple ID token's audience is the app's own bundle identifier (com.rally26.mobile), not
# a configurable client id.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
