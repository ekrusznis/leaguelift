# ---- Shared ----
ENVIRONMENT=local

# ---- Database ----
POSTGRES_DB=leaguelift
POSTGRES_USER=leaguelift
POSTGRES_PASSWORD=leaguelift_local_password
DATABASE_URL=jdbc:postgresql://localhost:5433/leaguelift

# ---- Auth (traditional email/password — ADR-014) ----
# Signs/validates the backend's self-issued JWTs (HS256). Must be at least 32 bytes,
# and different between staging and prod. Never commit a real value.
# There is no dev/test authentication bypass in any environment — register a real
# account via POST /api/v1/auth/register, or use one of the seeded dashboard-role
# accounts (backend/src/main/resources/db/seed/V9000__dev_seed_dashboard_role_users.sql,
# password "DevPassword123!" for all four).
JWT_SECRET=CHANGE-ME-at-least-32-bytes-long

# ---- Frontend -> Backend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Backend server ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- Stripe (Connect Express onboarding + campaign-contribution checkout, both
# test-mode only — ADR-005; no live charge routing yet) ----
# Test-mode secret key (sk_test_...). Blank locally is fine — onboarding/checkout
# calls just fail with a clear error until you supply one. Get a free test-mode key
# from a Stripe account's dashboard if you want to exercise the real flows.
STRIPE_SECRET_KEY=
# Signing secret for the POST /api/v1/webhooks/stripe endpoint (whsec_...). Used to
# confirm campaign contributions on checkout.session.completed — see the `fundraising`
# and `webhook` modules. Get this from the Stripe CLI (`stripe listen --forward-to
# localhost:8080/api/v1/webhooks/stripe`) for local testing, or the dashboard's
# webhook-endpoint config in staging/prod. Connect-account webhooks remain Phase 5.
STRIPE_WEBHOOK_SECRET=

# ---- Printify (catalog + draft-order creation only — Phase 4 slice 1; never calls
# send-to-production, so nothing here can trigger a real print run or charge) ----
# Personal access token from a Printify account. Blank locally is fine — catalog
# lookups (blueprints/print-providers/variants) and draft-order creation just fail
# with a clear error until you supply one.
PRINTIFY_API_TOKEN=
# A "Manual/API" Printify shop id — required only for draft-order creation, not for
# catalog reads. Create a free Printify account and a Manual/API-type shop to get one.
PRINTIFY_SHOP_ID=

# ---- Providers (not wired up until later phases; placeholders only) ----
RESEND_API_KEY=
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ---- Object storage (S3-compatible: MinIO locally via compose, DigitalOcean Spaces in staging/prod) ----
# Local dev: `docker compose up -d postgres minio minio-init`, then run the backend
# on the host (not in compose) so both the backend's own S3 calls and the presigned
# URLs it hands to the browser resolve to the same http://localhost:9000 endpoint.
SPACES_ENDPOINT=http://localhost:9000
SPACES_ACCESS_KEY=leaguelift
SPACES_SECRET_KEY=leaguelift_local_password
SPACES_BUCKET=leaguelift-local
SPACES_REGION=us-east-1
