# ---- Shared ----
ENVIRONMENT=local

# ---- Database ----
POSTGRES_DB=leaguelift
POSTGRES_USER=leaguelift
POSTGRES_PASSWORD=leaguelift_local_password
DATABASE_URL=jdbc:postgresql://localhost:5433/leaguelift

# ---- Auth (traditional email/password — ADR-014) ----
# Signs/validates the backend's self-issued JWTs (HS256). Must be at least 32 bytes,
# and different between staging and prod. Never commit a real value.
# There is no dev/test authentication bypass in any environment — register a real
# account via POST /api/v1/auth/register, or use one of the seeded dashboard-role
# accounts (backend/src/main/resources/db/seed/V9000__dev_seed_dashboard_role_users.sql,
# password "DevPassword123!" for all four).
JWT_SECRET=CHANGE-ME-at-least-32-bytes-long

# ---- Frontend -> Backend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Backend server ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- Providers (not wired up until later phases; placeholders only) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTIFY_API_TOKEN=
RESEND_API_KEY=
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ---- Object storage ----
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=leaguelift-local
DO_SPACES_REGION=nyc3
