# ---- Shared ----
ENVIRONMENT=local

# ---- Database ----
POSTGRES_DB=leaguelift
POSTGRES_USER=leaguelift
POSTGRES_PASSWORD=leaguelift_local_password
DATABASE_URL=jdbc:postgresql://localhost:5433/leaguelift

# ---- Auth (OIDC / Auth0) ----
# Used by the backend resource server to validate JWTs.
OIDC_ISSUER_URI=https://CHANGE-ME.us.auth0.com/
OIDC_AUDIENCE=https://api.leaguelift.local
# Used by the frontend (public, non-secret) Auth0 SPA config.
VITE_AUTH_DOMAIN=CHANGE-ME.us.auth0.com
VITE_AUTH_CLIENT_ID=CHANGE-ME
VITE_AUTH_AUDIENCE=https://api.leaguelift.local
# Enables in-memory local dev auth bypass. Must never be true outside the "local" profile.
VITE_AUTH_DEV_MODE=true

# ---- Frontend -> Backend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Backend server ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- Providers (not wired up until later phases; placeholders only) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTIFY_API_TOKEN=
RESEND_API_KEY=
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ---- Object storage ----
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=leaguelift-local
DO_SPACES_REGION=nyc3
