# ---- Shared ----
ENVIRONMENT=local

# ---- Database ----
POSTGRES_DB=rally26
POSTGRES_USER=rally26
POSTGRES_PASSWORD=rally26_local_password
DATABASE_URL=jdbc:postgresql://localhost:5433/rally26

# ---- Auth (traditional email/password — ADR-014) ----
# Signs/validates the backend's self-issued JWTs (HS256). Must be at least 32 bytes,
# and different between staging and prod. Never commit a real value.
# There is no dev/test authentication bypass in any environment — register a real
# account via POST /api/v1/auth/register, or use one of the seeded dashboard-role
# accounts (backend/src/main/resources/db/seed/V9000__dev_seed_dashboard_role_users.sql,
# password "DevPassword123!" for all four).
JWT_SECRET=CHANGE-ME-at-least-32-bytes-long

# ---- Frontend -> Backend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---- Backend server ----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- Stripe (Connect Express onboarding + campaign-contribution checkout, both
# test-mode only — ADR-005; no live charge routing yet) ----
# Test-mode secret key (sk_test_...). Blank locally is fine — onboarding/checkout
# calls just fail with a clear error until you supply one. Get a free test-mode key
# from a Stripe account's dashboard if you want to exercise the real flows.
STRIPE_SECRET_KEY=
# Signing secret for the POST /api/v1/webhooks/stripe endpoint (whsec_...). Used to
# confirm campaign contributions on checkout.session.completed — see the `fundraising`
# and `webhook` modules. Get this from the Stripe CLI (`stripe listen --forward-to
# localhost:8080/api/v1/webhooks/stripe`) for local testing, or the dashboard's
# webhook-endpoint config in staging/prod. Connect-account webhooks remain Phase 5.
STRIPE_WEBHOOK_SECRET=

# ---- Printify (catalog + draft-order creation only — Phase 4 slice 1; never calls
# send-to-production, so nothing here can trigger a real print run or charge) ----
# Personal access token from a Printify account. Blank locally is fine — catalog
# lookups (blueprints/print-providers/variants) and draft-order creation just fail
# with a clear error until you supply one.
PRINTIFY_API_TOKEN=
# A "Manual/API" Printify shop id — required only for draft-order creation, not for
# catalog reads. Create a free Printify account and a Manual/API-type shop to get one.
PRINTIFY_SHOP_ID=
# Phase 19 scaffold only; verified webhook lifecycle remains Phase 20.
PRINTIFY_WEBHOOK_SECRET=
PRINTIFY_WEBHOOK_ENABLED=false

# ---- Email (Phase 8 slice 1, ADR-022 — outbox worker + notification infrastructure) ----
# "logging" (default) just logs what would be sent — see LoggingEmailProvider. Flip to
# "resend" once RESEND_API_KEY/RESEND_FROM_ADDRESS below are real.
EMAIL_PROVIDER=logging
# Real Resend send only happens when EMAIL_PROVIDER=resend. Blank locally is fine —
# real send calls just fail with a clear error until you supply a real key.
RESEND_API_KEY=
# The "from" address Resend sends as — must be a verified sender/domain on your Resend
# account.
RESEND_FROM_ADDRESS=
# Phase 19 bounce/complaint webhook verification seam.
RESEND_WEBHOOK_SECRET=
# Used to build complete, clickable URLs in outbound emails (e.g. the invitation
# accept link) — the deployed frontend's own origin, no trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# ---- SMS (Phase 8 slice 3, ADR-024) ----
# "logging" (default) just logs what would be sent — see LoggingSmsProvider. Flip to
# "twilio" once the credentials below are real.
SMS_PROVIDER=logging
# From a Twilio account's console. Blank locally is fine — real send calls just fail
# with a clear error until you supply real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (E.164 format, e.g. +15551234567) capable of sending SMS.
TWILIO_FROM_NUMBER=

# ---- ICS feed sync (Phase 12 slice 3, ADR-033) ----
# How often every ACTIVE ICS_FEED connection is re-fetched and synced.
ICS_FEED_SYNC_ENABLED=true
ICS_FEED_SYNC_CRON=0 */30 * * * *

# ---- Platform economics (Phase 5 slice 1, ADR-017 — starting pilot values, not
# final pricing) ----
PLATFORM_FEE_BASIS_POINTS=500
PAYOUT_HOLDING_PERIOD_DAYS=7

# ---- Sponsorship renewal reminders (Phase 6 remainder, ADR-019; rebuilt on the
# outbox worker as of Phase 8 slice 1, ADR-022) ----
SPONSORSHIP_RENEWAL_REMINDER_ENABLED=true
SPONSORSHIP_RENEWAL_REMINDER_DAYS_BEFORE=14
SPONSORSHIP_RENEWAL_REMINDER_CRON=0 0 8 * * *

# ---- Fee-due payment reminders (Phase 8 slice 2, ADR-023 — same shape as the
# sponsorship renewal reminder above) ----
FEE_PAYMENT_REMINDER_ENABLED=true
FEE_PAYMENT_REMINDER_DAYS_BEFORE=3
FEE_PAYMENT_REMINDER_CRON=0 0 8 * * *

# ---- Outbox worker (Phase 8 slice 1, ADR-022 — the transactional-outbox consumer
# that dispatches email/SMS notifications) ----
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=20
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_BACKOFF_BASE_SECONDS=30
OUTBOX_WORKER_BACKOFF_CAP_SECONDS=3600

# ---- Phase 19 integration connection/OAuth foundation ----
# Keep every provider disabled until Phase 20 supplies official credentials, verified
# endpoints/scopes, sandbox tests, and an explicit feature-flag activation. Generate
# the credential-encryption key with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
INTEGRATION_OAUTH_STATE_TTL_MINUTES=10
INTEGRATION_OAUTH_CALLBACK_BASE_URL=http://localhost:8080/api/v1/integrations/oauth
# Local/test only. Startup is rejected if this is true in staging or production.
INTEGRATION_STUB_MODE=false

GOOGLE_CALENDAR_INTEGRATION_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_AUTHORIZATION_URI=
GOOGLE_CALENDAR_TOKEN_URI=
GOOGLE_CALENDAR_REVOCATION_URI=

QUICKBOOKS_INTEGRATION_ENABLED=false
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_AUTHORIZATION_URI=
QUICKBOOKS_TOKEN_URI=
QUICKBOOKS_REVOCATION_URI=

SPORTSENGINE_INTEGRATION_ENABLED=false
SPORTSENGINE_CLIENT_ID=
SPORTSENGINE_CLIENT_SECRET=
SPORTSENGINE_AUTHORIZATION_URI=
SPORTSENGINE_TOKEN_URI=
SPORTSENGINE_REVOCATION_URI=

# ---- Providers (not wired up until later phases; placeholders only) ----
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ---- Object storage (S3-compatible: MinIO locally via compose, DigitalOcean Spaces in staging/prod) ----
# Local dev: `docker compose up -d postgres minio minio-init`, then run the backend
# on the host (not in compose) so both the backend's own S3 calls and the presigned
# URLs it hands to the browser resolve to the same http://localhost:9000 endpoint.
SPACES_ENDPOINT=http://localhost:9000
SPACES_ACCESS_KEY=rally26
SPACES_SECRET_KEY=rally26_local_password
SPACES_BUCKET=rally26-local
SPACES_REGION=us-east-1

# Public support routing address (real mailbox activation is Phase 20).
RALLY26_SUPPORT_INBOX_EMAIL=support@rally26.com

# Optional public social profile URLs. Leave blank until the profile is real.
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_X_URL=
