server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: let React Router handle unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;
    add_header X-Frame-Options DENY;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()";
    # script-src/connect-src additions (2026-08-12, Workstream C): New Relic's browser
    # agent (frontend/src/monitoring/newRelicBrowser.ts) loads supplementary script
    # chunks from js-agent.newrelic.com and reports RUM data to bam(-cell).nr-data.net
    # — both no-ops with no network activity at all while VITE_NEW_RELIC_APP_ID/
    # VITE_NEW_RELIC_BROWSER_LICENSE_KEY stay unset, but the CSP must already allow
    # them for the day those are configured, since a CSP violation is silent (no
    # visible error) rather than something a follow-up deploy would surface.
    #
    # connect-src uses ${API_ORIGIN}/${STORAGE_ORIGIN} (envsubst'd from this file's
    # .template name at container startup by nginx's built-in docker-entrypoint
    # templating, not baked at image build time) so the same image works against the
    # production API/storage domains and against a local/staging backend without a
    # rebuild. Defaults are set in Dockerfile; compose.yaml overrides both for local
    # docker-compose. A CSP mismatch here silently blocks every browser API/upload call
    # with no server-side log line — see LR-005 (API) and LR-029 (storage: the browser
    # PUTs file bytes directly to object storage per DESIGN-DOC.md section 11.3, so its
    # origin must be allow-listed here too, not just the API's).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://js-agent.newrelic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${API_ORIGIN} ${STORAGE_ORIGIN} https://bam.nr-data.net https://bam-cell.nr-data.net; frame-ancestors 'none'; base-uri 'self'; object-src 'none'";
}
