# Template for /opt/rally26/.env on the prod droplet. Real values are written there
# by the deploy workflow (from GitHub Secrets) — this file documents what's required
# and is never itself committed with real values. See docs/adr/ADR-008 for how this
# maps to GitHub Secrets.

REGISTRY=registry.digitalocean.com/rally26
IMAGE_TAG=latest

POSTGRES_DB=rally26
POSTGRES_USER=rally26
POSTGRES_PASSWORD=

# openssl rand -base64 48 — must differ from staging's value.
JWT_SECRET=

# DigitalOcean Spaces — reusing the existing ll-allbuckets-1785762425006 bucket.
# Endpoint format: https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=ll-allbuckets-1785762425006
SPACES_REGION=

# Test-mode keys are fine for the first prod deploy — Stripe/Printify only fail
# closed on real charge/order attempts without live keys (see application-prod.yml).
# The process itself still won't boot at all if these are entirely unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional — default to "logging" (no real send) until real accounts are activated
# (Phase 20).
EMAIL_PROVIDER=logging
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
SMS_PROVIDER=logging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

BACKUP_RETENTION_DAYS=14
